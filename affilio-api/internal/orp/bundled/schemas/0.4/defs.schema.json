{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.onrender.com/orp/schemas/0.4/defs.schema.json",
  "title": "ORP 0.4 shared definitions",
  "description": "Types added for many-party deals. A 0.3 message does not use this file. Identity is a hash and an issuer name. A deposit term names an outside holder. Offer Rails does not hold money.",
  "$defs": {
    "Role": {
      "title": "PartyRole",
      "description": "The seat this party holds. offerer opened the deal. acceptor is the counterparty on a two-role deal. The other roles are additional seats.",
      "type": "string",
      "enum": ["offerer", "acceptor", "curator", "facilitator", "service", "signer", "member"]
    },
    "PartyTerms": {
      "title": "PartyTerms",
      "description": "What this seat is paid or owes. Percent splits are integers. Fixed amounts use amount. A deposit names who holds it outside Offer Rails.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "amount": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Money" },
        "cap": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Money" },
        "per": { "type": "string", "enum": ["deal", "hour", "viewing"] },
        "hours": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "deposit": { "$ref": "#/$defs/Deposit" }
      }
    },
    "Deposit": {
      "title": "Deposit",
      "description": "A term that records who holds a deposit. The holder is outside Offer Rails. The proof records the agreed term and does not move money.",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "holder"],
      "properties": {
        "amount": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Money" },
        "holder": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "Identity": {
      "title": "IdentityAttestation",
      "description": "A hash of an attestation plus the issuer name. No name, email, or other personal data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "issuer"],
      "properties": {
        "hash": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Hash" },
        "issuer": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
      }
    },
    "PartySeat": {
      "title": "PartySeat",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "required"],
      "properties": {
        "id": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" },
        "role": { "$ref": "#/$defs/Role" },
        "required": { "type": "boolean" },
        "terms": { "$ref": "#/$defs/PartyTerms" },
        "identity": { "$ref": "#/$defs/Identity" }
      }
    },
    "DealParty": {
      "title": "DealParty",
      "description": "A seat on a deal snapshot, including whether that party has signed the current terms_hash.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "required", "signed"],
      "properties": {
        "id": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" },
        "role": { "$ref": "#/$defs/Role" },
        "required": { "type": "boolean" },
        "signed": { "type": "boolean" },
        "terms": { "$ref": "#/$defs/PartyTerms" },
        "identity": { "$ref": "#/$defs/Identity" }
      }
    },
    "ClaimValue": {
      "title": "ClaimValue",
      "description": "unknown when nobody checked the field. A checked field carries the value, checked_at, and expires_at.",
      "anyOf": [
        { "type": "string", "const": "unknown" },
        { "type": "string", "minLength": 1, "maxLength": 500 },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "checked_at", "expires_at"],
          "properties": {
            "value": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 500 },
                { "type": "number" },
                { "type": "boolean" }
              ]
            },
            "checked_at": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
            "expires_at": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" }
          }
        }
      ]
    },
    "Claims": {
      "title": "Claims",
      "description": "Named fields on an offer. A field nobody checked is unknown. The host does not fill a default.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
      "additionalProperties": { "$ref": "#/$defs/ClaimValue" }
    },
    "Obligation": {
      "title": "Obligation",
      "description": "One thing a seat must do. by is a role or a party id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action"],
      "properties": {
        "id": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ObligationId" },
        "by": {
          "anyOf": [
            { "$ref": "#/$defs/Role" },
            { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" }
          ]
        },
        "action": { "type": "string", "enum": ["place", "repost", "comment", "pay", "credit", "share"] },
        "space": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/SpaceRef" },
        "content": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Content" },
        "destination": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Url" },
        "target": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Url" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "clicks": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "quote": { "type": "boolean" },
        "proof": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ProofList" },
        "amount": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Money" },
        "cap": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Money" },
        "rate_bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "per": { "type": "string", "enum": ["deal", "placement", "click", "conversion", "hour"] },
        "window": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Duration" },
        "hold": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Duration" },
        "after": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ObligationId" },
        "due": {
          "anyOf": [
            { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
            { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Duration" }
          ]
        },
        "keep": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Duration" },
        "rail": { "type": "string", "pattern": "^[a-z0-9_.-]{2,40}$" },
        "credits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "note": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Text" }
      }
    },
    "Terms": {
      "title": "Terms",
      "description": "Shared terms. checked_at and expires_at are the maker confirmation window (checked_at plus 90 days). claims holds per-field check results.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "obligations"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/DealKind" },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/Obligation" }
        },
        "categories": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Category" }
        },
        "disclosure": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Disclosure" },
        "starts": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
        "ends": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
        "checked_at": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
        "expires_at": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
        "claims": { "$ref": "#/$defs/Claims" }
      }
    },
    "MessageType": {
      "title": "MessageType",
      "description": "The 0.3 message types plus leave and seat. A 0.3 message cannot name leave or seat.",
      "anyOf": [
        {
          "type": "string",
          "enum": ["hello", "discover", "results", "space", "request", "offer", "counter", "accept", "decline", "deal", "execute", "receipt", "outcome", "payout", "revoke", "consent", "dispute", "reputation", "error", "leave", "seat"]
        },
        { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ExtName" }
      ]
    },
    "Capabilities": {
      "title": "Capabilities",
      "description": "What a 0.4 host advertises. messages may include leave and seat.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messages": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/MessageType" } },
        "spaces": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/SpaceKind" } },
        "actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$" } },
        "proofs": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ProofMethod" } },
        "tracking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "links": { "type": "boolean" },
            "codes": { "type": "boolean" }
          }
        },
        "signatures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["EdDSA", "ES256"] } },
            "required": { "type": "boolean" }
          }
        },
        "inbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "poll": { "type": "boolean" },
            "webhook": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Url" }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claims": { "type": "string", "enum": ["real", "stub", "none"] }
          }
        },
        "ext": { "type": "array", "uniqueItems": true, "items": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ExtName" } }
      }
    }
  }
}
