{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.onrender.com/orp/schemas/0.4/messages/deal.schema.json",
  "title": "DealMessage",
  "description": "A many-party deal snapshot. State is pending until every required party has signed. Optional parties do not block active.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "required": ["type", "body", "deal"],
  "properties": {
    "type": { "const": "deal" },
    "body": { "$ref": "#/$defs/DealBody" }
  },
  "$defs": {
    "DealBody": {
      "title": "DealBody",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "parties", "terms", "terms_hash", "updated"],
      "properties": {
        "state": { "$ref": "#/$defs/DealState" },
        "parties": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": { "$ref": "../defs.schema.json#/$defs/DealParty" }
        },
        "offerer": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" },
        "acceptor": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" },
        "offer": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/LocalId" },
        "terms": { "$ref": "../defs.schema.json#/$defs/Terms" },
        "terms_hash": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Hash" },
        "round": { "type": "integer", "minimum": 1, "maximum": 100 },
        "bound": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["party", "authority", "at"],
            "properties": {
              "party": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" },
              "authority": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Authority" },
              "at": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" }
            }
          }
        },
        "vacancies": {
          "description": "Roles whose required seat is empty. The deal stays pending until the required replacement seated for that vacancy signs. An original seat of the same role does not clear it. An optional seat of that role does not clear it.",
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "../defs.schema.json#/$defs/Role" }
        },
        "waiting": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Waiting" },
        "tracking": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Tracking" }
        },
        "obligations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state"],
            "properties": {
              "id": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/ObligationId" },
              "state": { "type": "string", "enum": ["pending", "claimed", "verified", "failed", "revoked", "waived"] },
              "due": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
              "receipt": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/MessageId" }
            }
          }
        },
        "expires": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
        "updated": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/Timestamp" },
        "approved_by": {
          "description": "Who approved each ask step on an ORP 0.4 deal only. A 0.3 deal does not include approved_by. party is the seat id already on the deal, not a name or email. approved_by is agent or owner. agent is the waiting party's bearer and is not a person's approval. owner is the signed-in owner who submitted the form.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "party", "approved_by"],
            "properties": {
              "step": { "type": "string", "enum": ["list", "negotiate", "accept", "execute", "amend", "settle", "share", "revoke"] },
              "party": { "$ref": "https://offer-rails.onrender.com/orp/schemas/defs.schema.json#/$defs/PartyId" },
              "approved_by": { "type": "string", "enum": ["agent", "owner"] }
            }
          }
        },
        "approvals_unavailable": {
          "description": "True only on an ORP 0.4 deal read when the host could not load who approved. The response stays HTTP 200. approved_by is omitted. A 0.3 deal does not include approvals_unavailable.",
          "const": true
        }
      }
    },
    "DealState": {
      "title": "DealState",
      "description": "pending: a required signature is missing. active: every required party has signed. The other states match 0.3.",
      "type": "string",
      "enum": ["pending", "proposed", "awaiting", "active", "completed", "declined", "expired", "revoked", "disputed"]
    }
  }
}
