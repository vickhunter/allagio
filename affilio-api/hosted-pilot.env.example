PUBLIC_BASE_URL=https://your-private-pilot-domain.example
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
DATABASE_URL=
CONNECTION_ENCRYPTION_KEY=
ADMIN_API_KEY=
# Required when GIN_MODE=release. Must not be empty or dev-secret.
API_KEY_SECRET=
ALLOWED_ORIGINS=https://your-private-pilot-domain.example
# Comma-separated proxy IPs or CIDRs allowed to set X-Forwarded-For and X-Real-IP.
# Leave empty unless the process sits behind a known proxy. Empty trusts nobody.
# Render's recommended ranges are in docs/HOSTING.md. Do not use 0.0.0.0/0.
TRUSTED_PROXIES=
GIN_MODE=release
PORT=8080
AUTO_MIGRATE=false
UI_ASSETS_PATH=
DOWNLOADS_PATH=
OPERATOR_OWNER_ID=
