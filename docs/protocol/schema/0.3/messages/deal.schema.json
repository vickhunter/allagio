{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.onrender.com/orp/schemas/messages/deal.schema.json",
  "title": "DealMessage",
  "description": "The host's snapshot of a deal. It is the reply to every message that changes a deal, and it lands in both parties' inboxes. Each party gets its own copy: escalation ids, reasons and approval URLs appear only in the copy for the party that is waiting.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "required": ["type", "body", "deal"],
  "properties": {
    "type": { "const": "deal" },
    "body": { "$ref": "#/$defs/DealBody" }
  },
  "$defs": {
    "DealBody": {
      "title": "DealBody",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "offerer", "acceptor", "terms", "terms_hash", "updated"],
      "properties": {
        "state": { "$ref": "#/$defs/DealState" },
        "offerer": { "$ref": "../defs.schema.json#/$defs/PartyId" },
        "acceptor": { "$ref": "../defs.schema.json#/$defs/PartyId" },
        "offer": { "$ref": "../defs.schema.json#/$defs/LocalId", "description": "The standing offer this deal came from, if any." },
        "terms": { "$ref": "../defs.schema.json#/$defs/Terms" },
        "terms_hash": { "$ref": "../defs.schema.json#/$defs/Hash" },
        "round": { "type": "integer", "minimum": 1, "maximum": 100 },
        "bound": {
          "description": "Who is bound to terms_hash, and by what authority.",
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["party", "authority", "at"],
            "properties": {
              "party": { "$ref": "../defs.schema.json#/$defs/PartyId" },
              "authority": { "$ref": "../defs.schema.json#/$defs/Authority" },
              "at": { "$ref": "../defs.schema.json#/$defs/Timestamp" }
            }
          }
        },
        "waiting": { "$ref": "../defs.schema.json#/$defs/Waiting" },
        "tracking": { "type": "array", "maxItems": 20, "items": { "$ref": "../defs.schema.json#/$defs/Tracking" } },
        "obligations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state"],
            "properties": {
              "id": { "$ref": "../defs.schema.json#/$defs/ObligationId" },
              "state": { "type": "string", "enum": ["pending", "claimed", "verified", "failed", "revoked", "waived"] },
              "due": { "$ref": "../defs.schema.json#/$defs/Timestamp" },
              "receipt": { "$ref": "../defs.schema.json#/$defs/MessageId" }
            }
          }
        },
        "spaces": {
          "description": "Spaces named in the deal, with locators revealed once the deal is active.",
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "../defs.schema.json#/$defs/Space" }
        },
        "expires": { "$ref": "../defs.schema.json#/$defs/Timestamp" },
        "updated": { "$ref": "../defs.schema.json#/$defs/Timestamp" },
        "approved_by": {
          "description": "Who approved each ask step. agent is the waiting party's bearer and is not a person's approval. owner is the signed-in owner who submitted the form. The list has no name, email, or owner id.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "approved_by"],
            "properties": {
              "step": { "type": "string", "enum": ["list", "negotiate", "accept", "execute", "amend", "settle", "share", "revoke"] },
              "approved_by": { "type": "string", "enum": ["agent", "owner"] }
            }
          }
        }
      }
    },
    "DealState": {
      "title": "DealState",
      "description": "proposed: terms on the table. awaiting: the waiting party's agent approves the ask by default. The host records approved_by agent. That is not a person's approval. The signed-in owner submits the form and the host records approved_by owner. Opening the URL records nothing. active: both bound, tracking live. completed: every obligation verified or waived. declined, expired, revoked: ended before or after activation. disputed: a dispute is open.",
      "type": "string",
      "enum": ["proposed", "awaiting", "active", "completed", "declined", "expired", "revoked", "disputed"]
    }
  }
}
