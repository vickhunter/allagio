{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.onrender.com/orp/schemas/http/inbox.schema.json",
  "title": "InboxPage",
  "description": "The response to GET {endpoint}/inbox?after=<cursor>: messages for the caller's party, oldest first. Pass next back as after to continue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["messages", "next"],
  "properties": {
    "messages": { "type": "array", "maxItems": 100, "items": { "$ref": "../message.schema.json" } },
    "next": { "type": "string", "maxLength": 200 }
  }
}
