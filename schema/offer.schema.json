{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.com/schema/v0.3/offer.schema.json",
  "title": "ORP v0.3 Offer Message",
  "type": "object",
  "required": [
    "orp_version",
    "message_id",
    "message_type",
    "deal_id",
    "sender",
    "recipient",
    "timestamp",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "orp_version": {
      "$ref": "common.schema.json#/$defs/OrpVersion"
    },
    "message_id": {
      "type": "string",
      "minLength": 4
    },
    "message_type": {
      "const": "offer"
    },
    "deal_id": {
      "type": "string",
      "minLength": 4
    },
    "sender": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "recipient": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 4
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    },
    "payload": {
      "type": "object",
      "required": ["seq", "terms", "terms_hash", "expires_at"],
      "properties": {
        "seq": {
          "const": 1
        },
        "terms": {
          "$ref": "common.schema.json#/$defs/DealTerms"
        },
        "terms_hash": {
          "$ref": "common.schema.json#/$defs/Sha256Hash"
        },
        "rationale": {
          "type": "string",
          "maxLength": 1000
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
