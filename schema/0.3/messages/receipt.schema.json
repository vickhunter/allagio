{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offerrails.com/orp/schema/0.3/messages/receipt.schema.json",
  "title": "ReceiptMessage",
  "description": "A verifier's finding about one obligation. The host sends receipts for link, proof_url, platform_check, witness and provider checks. The counterparty sends a receipt with method attestation to confirm (or reject) work it saw itself. Only receipts count toward reputation; execute claims never do.",
  "type": "object",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "required": ["type", "body", "deal"],
  "properties": {
    "type": { "const": "receipt" },
    "body": { "$ref": "#/$defs/ReceiptBody" }
  },
  "$defs": {
    "ReceiptBody": {
      "title": "ReceiptBody",
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "result", "method", "at"],
      "properties": {
        "obligation": { "$ref": "../defs.schema.json#/$defs/ObligationId" },
        "result": { "type": "string", "enum": ["verified", "failed", "partial"] },
        "method": { "$ref": "../defs.schema.json#/$defs/ProofMethod" },
        "at": { "$ref": "../defs.schema.json#/$defs/Timestamp" },
        "url": { "$ref": "../defs.schema.json#/$defs/Url", "description": "What was checked." },
        "found": {
          "description": "What the check saw at url.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "link": { "type": "boolean" },
            "code": { "type": "boolean" },
            "disclosure": { "type": "boolean" },
            "target": { "type": "boolean" },
            "content": { "type": "boolean" }
          }
        },
        "reason": { "type": "string", "enum": ["not_found", "link_missing", "disclosure_missing", "content_mismatch", "removed", "unreachable", "too_early", "too_late", "not_public", "other"] },
        "settlement": {
          "description": "For pay obligations: where the money moved. ORP never holds funds.",
          "type": "object",
          "additionalProperties": false,
          "required": ["rail", "amount"],
          "properties": {
            "rail": { "type": "string", "pattern": "^[a-z0-9_.-]{2,40}$" },
            "ref": { "type": "string", "maxLength": 200 },
            "amount": { "$ref": "../defs.schema.json#/$defs/Money" }
          }
        },
        "next_check": { "$ref": "../defs.schema.json#/$defs/Timestamp", "description": "For keep periods: when the verifier looks again." }
      }
    }
  }
}
