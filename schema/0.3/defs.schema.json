{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offerrails.com/orp/schema/0.3/defs.schema.json",
  "title": "ORP 0.3 shared definitions",
  "description": "Types shared by every ORP 0.3 message. Core objects are closed (additionalProperties false); extension data goes in the envelope's ext field.",
  "$defs": {
    "Version": {
      "title": "Version",
      "description": "Protocol version, MAJOR.MINOR.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "PartyId": {
      "title": "PartyId",
      "description": "Pseudonymous party id: orp:<host>/<opaque>. The opaque part is random and never encodes a name, email, handle or domain of the owner.",
      "type": "string",
      "pattern": "^orp:[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?/[A-Za-z0-9_-]{1,64}$",
      "maxLength": 330
    },
    "MessageId": {
      "title": "MessageId",
      "description": "Sender-chosen id, unique per sender. Doubles as the idempotency key.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
    },
    "LocalId": {
      "title": "LocalId",
      "description": "Host-scoped id for deals, spaces, offers, escalations, consents and disputes.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$"
    },
    "ObligationId": {
      "title": "ObligationId",
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$"
    },
    "Hash": {
      "title": "Hash",
      "description": "sha256- followed by the unpadded base64url SHA-256 digest of the RFC 8785 (JCS) canonical JSON.",
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "Timestamp": {
      "title": "Timestamp",
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "Duration": {
      "title": "Duration",
      "description": "ISO 8601 duration, for example P7D or PT12H.",
      "type": "string",
      "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
    },
    "Url": {
      "title": "Url",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "ExtName": {
      "title": "ExtName",
      "description": "Reverse-DNS extension name, for example com.example.boost.",
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "maxLength": 128
    },
    "Text": {
      "title": "Text",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "Money": {
      "title": "Money",
      "description": "Integer amount in the currency's minor unit (cents for EUR and USD).",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": { "type": "integer", "minimum": 0, "maximum": 100000000000 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "MessageType": {
      "title": "MessageType",
      "anyOf": [
        {
          "type": "string",
          "enum": ["hello", "discover", "results", "ask", "offer", "counter", "accept", "decline", "deal", "execute", "receipt", "outcome", "revoke", "consent", "dispute", "reputation", "error"]
        },
        { "$ref": "#/$defs/ExtName" }
      ]
    },
    "SpaceKind": {
      "title": "SpaceKind",
      "description": "Core kinds are family.kind. Extension kinds use reverse-DNS with at least three labels.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "web.article",
            "web.page",
            "newsletter.issue",
            "newsletter.dedicated",
            "social.post",
            "social.reply",
            "social.repost",
            "social.profile",
            "video.description",
            "video.segment",
            "video.comment",
            "audio.segment",
            "audio.notes",
            "community.post",
            "community.comment",
            "community.message",
            "app.slot",
            "data.feed"
          ]
        },
        { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+){2,}$", "maxLength": 128 }
      ]
    },
    "Platform": {
      "title": "Platform",
      "anyOf": [
        {
          "type": "string",
          "enum": ["web", "newsletter", "x", "youtube", "instagram", "tiktok", "facebook", "linkedin", "reddit", "discord", "telegram", "podcast", "app", "other"]
        },
        { "$ref": "#/$defs/ExtName" }
      ]
    },
    "DealKind": {
      "title": "DealKind",
      "description": "A hint for discovery; the obligations are what bind. affiliate: paid per conversion on a tracked link. sponsored: paid per deal or placement. swap: space for space. traffic_swap: tracked clicks for tracked clicks. link_exchange: links on each other's pages. repost: a repost, retweet or quote. comment: a comment or comment space. cross_sell: one product offered to another's customers, including upsells at checkout or upgrade. data: aggregate data exchange. partnership: anything longer-running.",
      "type": "string",
      "enum": ["affiliate", "sponsored", "swap", "traffic_swap", "link_exchange", "repost", "comment", "cross_sell", "data", "partnership"]
    },
    "ProofMethod": {
      "title": "ProofMethod",
      "description": "link: human clicks on the deal's tracking link. proof_url: a public URL the verifier fetched. platform_check: the platform's public interface (oEmbed, public API, feed, archive). attestation: the counterparty confirms. witness: a host-controlled observer, such as a seed inbox. provider: a payment provider event.",
      "anyOf": [
        { "type": "string", "enum": ["link", "proof_url", "platform_check", "attestation", "witness", "provider"] },
        { "$ref": "#/$defs/ExtName" }
      ]
    },
    "Step": {
      "title": "Step",
      "description": "A step an owner can set to auto, ask or off.",
      "type": "string",
      "enum": ["list", "negotiate", "accept", "execute", "amend", "settle", "share", "revoke"]
    },
    "StepMode": {
      "title": "StepMode",
      "type": "string",
      "enum": ["auto", "ask", "off"]
    },
    "Steps": {
      "title": "Steps",
      "description": "The mode of each step. A missing step uses the default: ask, except revoke, which is auto.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": { "$ref": "#/$defs/StepMode" },
        "negotiate": { "$ref": "#/$defs/StepMode" },
        "accept": { "$ref": "#/$defs/StepMode" },
        "execute": { "$ref": "#/$defs/StepMode" },
        "amend": { "$ref": "#/$defs/StepMode" },
        "settle": { "$ref": "#/$defs/StepMode" },
        "share": { "$ref": "#/$defs/StepMode" },
        "revoke": { "$ref": "#/$defs/StepMode" }
      }
    },
    "Agent": {
      "title": "Agent",
      "description": "The software acting for the party. Never a person.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_. -]{1,64}$" },
        "version": { "type": "string", "maxLength": 32 }
      }
    },
    "EscalationReason": {
      "title": "EscalationReason",
      "type": "string",
      "enum": ["step_ask", "over_budget", "over_threshold", "new_counterparty", "low_reputation", "category_outside", "space_outside", "kind_outside", "duration_over", "mandate_expired"]
    },
    "SizeBucket": {
      "title": "SizeBucket",
      "type": "string",
      "enum": ["<1k", "1k-10k", "10k-100k", "100k-1m", ">1m"]
    },
    "ShareBucket": {
      "title": "ShareBucket",
      "type": "string",
      "enum": ["<10%", "10-25%", "25-50%", ">50%"]
    },
    "Category": {
      "title": "Category",
      "description": "Lowercase dotted category, for example software.devtools.",
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$",
      "maxLength": 64
    },
    "Disclosure": {
      "title": "Disclosure",
      "description": "The label readers see next to the placement, in the reader's language.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 2, "maxLength": 80 },
        "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
      }
    },
    "Audience": {
      "title": "Audience",
      "description": "Aggregate audience description. Buckets only. Any segment smaller than k_min people is omitted.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "$ref": "#/$defs/SizeBucket" },
        "regions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "share"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "share": { "$ref": "#/$defs/ShareBucket" }
            }
          }
        },
        "k_min": { "type": "integer", "minimum": 50 },
        "source": { "type": "string", "enum": ["self_report", "platform", "host_measured"] }
      }
    },
    "Verification": {
      "title": "Verification",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "at"],
      "properties": {
        "method": { "type": "string", "enum": ["domain", "dns", "platform_oauth", "bio_token", "challenge_post"] },
        "at": { "$ref": "#/$defs/Timestamp" },
        "by": { "$ref": "#/$defs/PartyId" }
      }
    },
    "Space": {
      "title": "Space",
      "description": "A place an owner controls where content can appear. The locator may be withheld until a deal is active.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platform"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "kind": { "$ref": "#/$defs/SpaceKind" },
        "platform": { "$ref": "#/$defs/Platform" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "locator": { "$ref": "#/$defs/Url" },
        "topics": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/Category" } },
        "languages": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z]{2,3}$" } },
        "audience": { "$ref": "#/$defs/Audience" },
        "accepts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/DealKind" } },
        "disclosure": { "$ref": "#/$defs/Disclosure" },
        "verified": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/Verification" } },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rel": { "type": "string", "enum": ["sponsored", "nofollow", "none"] },
            "max_per_week": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "excluded_categories": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/Category" } }
          }
        },
        "adapter": { "type": "string", "pattern": "^[a-z0-9.-]+@[0-9]+\\.[0-9]+$" }
      }
    },
    "SpaceRef": {
      "title": "SpaceRef",
      "description": "Either one named space, or any space of these kinds owned by the obligor.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "kinds": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/SpaceKind" } }
      },
      "minProperties": 1
    },
    "Role": {
      "title": "Role",
      "description": "offerer is the party that opened the deal; acceptor is the other party. Roles never swap during a deal.",
      "type": "string",
      "enum": ["offerer", "acceptor"]
    },
    "Content": {
      "title": "Content",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link": { "type": "boolean", "description": "Must carry the deal's tracking link." },
        "code": { "type": "boolean", "description": "Must carry the deal's tracking code." },
        "direct": { "type": "boolean", "description": "Link straight to the destination instead of the tracking link, as in a link exchange. The link must carry rel=\"sponsored\" or rel=\"nofollow\". Proven by proof_url and rechecked while keep lasts; clicks are not counted." },
        "brief": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "copy": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Exact text, when the counterparty fixes it." },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "must_include": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "must_not_include": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "ProofList": {
      "title": "ProofList",
      "description": "Proofs the counterparty accepts for this obligation; any one is enough.",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ProofMethod" }
    },
    "Deadline": {
      "title": "Deadline",
      "description": "A timestamp, or a duration counted from the moment the deal becomes active.",
      "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "$ref": "#/$defs/Duration" }]
    },
    "PlaceObligation": {
      "title": "PlaceObligation",
      "description": "Put content, usually the tracking link or code, somewhere. Without space, any surface the obligor controls counts: the tracking link works everywhere.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action", "proof"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "const": "place" },
        "space": { "$ref": "#/$defs/SpaceRef" },
        "content": { "$ref": "#/$defs/Content" },
        "destination": { "$ref": "#/$defs/Url" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "clicks": { "type": "integer", "minimum": 1, "maximum": 10000000, "description": "Done once the tracking link has counted this many human clicks, as in a traffic swap. Without it, the first human click proves the placement." },
        "due": { "$ref": "#/$defs/Deadline" },
        "keep": { "$ref": "#/$defs/Duration" },
        "proof": { "$ref": "#/$defs/ProofList" }
      }
    },
    "RepostObligation": {
      "title": "RepostObligation",
      "description": "Repost or share a public item. No click is needed; proof is a receipt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action", "target", "proof"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "const": "repost" },
        "target": { "$ref": "#/$defs/Url" },
        "space": { "$ref": "#/$defs/SpaceRef" },
        "quote": { "type": "boolean" },
        "due": { "$ref": "#/$defs/Deadline" },
        "keep": { "$ref": "#/$defs/Duration" },
        "proof": { "$ref": "#/$defs/ProofList" }
      }
    },
    "CommentObligation": {
      "title": "CommentObligation",
      "description": "Comment on a public item, or let the counterparty use a comment space.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action", "target", "proof"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "const": "comment" },
        "target": { "$ref": "#/$defs/Url" },
        "content": { "$ref": "#/$defs/Content" },
        "due": { "$ref": "#/$defs/Deadline" },
        "keep": { "$ref": "#/$defs/Duration" },
        "proof": { "$ref": "#/$defs/ProofList" }
      }
    },
    "PayObligation": {
      "title": "PayObligation",
      "description": "Pay money: a fixed amount, per click, per conversion (fixed or rate), or per placement. Settlement happens on a payment rail, never inside ORP.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action", "per"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "const": "pay" },
        "per": { "type": "string", "enum": ["deal", "placement", "click", "conversion"] },
        "amount": { "$ref": "#/$defs/Money" },
        "rate_bps": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "Share of the sale in basis points, for per conversion." },
        "cap": { "$ref": "#/$defs/Money", "description": "The most this obligation can cost over the whole deal." },
        "window": { "$ref": "#/$defs/Duration", "description": "For per conversion: how long after a counted click a sale still counts." },
        "after": { "$ref": "#/$defs/ObligationId", "description": "The obligation this pay is tied to. Per deal or placement: paid once it is verified. Per click or conversion: counted on its tracking link only. Absent: every tracking link in the deal." },
        "due": { "$ref": "#/$defs/Deadline" },
        "rail": { "type": "string", "pattern": "^[a-z0-9_.-]{2,40}$", "description": "stripe, lemonsqueezy, polar, manual, or an extension name." },
        "proof": { "$ref": "#/$defs/ProofList" }
      },
      "anyOf": [{ "required": ["amount"] }, { "required": ["rate_bps"] }]
    },
    "CreditObligation": {
      "title": "CreditObligation",
      "description": "Give non-cash credits, for traffic exchange or reposts. Credits are host-scoped and never convert to money inside ORP.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action", "credits"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "const": "credit" },
        "credits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "after": { "$ref": "#/$defs/ObligationId" }
      }
    },
    "ShareObligation": {
      "title": "ShareObligation",
      "description": "Share an aggregate, non-personal dataset. Personal data never crosses between agents.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "by", "action", "data", "proof"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "const": "share" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "fields", "k_min", "purpose", "retention"],
          "properties": {
            "class": { "const": "aggregate" },
            "fields": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" } },
            "k_min": { "type": "integer", "minimum": 50 },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
            "retention": { "$ref": "#/$defs/Duration" },
            "location": { "$ref": "#/$defs/Url" }
          }
        },
        "due": { "$ref": "#/$defs/Deadline" },
        "proof": { "$ref": "#/$defs/ProofList" }
      }
    },
    "ExtensionObligation": {
      "title": "ExtensionObligation",
      "description": "An obligation defined by an extension. Hosts that do not know the action must refuse the terms.",
      "type": "object",
      "required": ["id", "by", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/ObligationId" },
        "by": { "$ref": "#/$defs/Role" },
        "action": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+){2,}$" },
        "proof": { "$ref": "#/$defs/ProofList" }
      }
    },
    "Obligation": {
      "title": "Obligation",
      "oneOf": [
        { "$ref": "#/$defs/PlaceObligation" },
        { "$ref": "#/$defs/RepostObligation" },
        { "$ref": "#/$defs/CommentObligation" },
        { "$ref": "#/$defs/PayObligation" },
        { "$ref": "#/$defs/CreditObligation" },
        { "$ref": "#/$defs/ShareObligation" },
        { "$ref": "#/$defs/ExtensionObligation" }
      ]
    },
    "Terms": {
      "title": "Terms",
      "description": "What each side will do. terms_hash is the JCS SHA-256 of this object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "obligations"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "$ref": "#/$defs/DealKind" },
        "obligations": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/Obligation" } },
        "categories": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/Category" } },
        "disclosure": { "$ref": "#/$defs/Disclosure" },
        "starts": { "$ref": "#/$defs/Timestamp" },
        "ends": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Tracking": {
      "title": "Tracking",
      "description": "The link and optional code the host mints for one obligation when a deal becomes active. They work wherever a person can click or type them: email, social posts, video descriptions, podcast notes, a blog. No adapter or platform integration is needed. After revoke or end, status is plain: the link still redirects but no longer counts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "link", "destination", "status"],
      "properties": {
        "obligation": { "$ref": "#/$defs/ObligationId" },
        "link": { "$ref": "#/$defs/Url" },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,32}$" },
        "destination": { "$ref": "#/$defs/Url" },
        "status": { "type": "string", "enum": ["live", "plain"] },
        "expires": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ClickCounts": {
      "title": "ClickCounts",
      "description": "Aggregate click counts by class. Only human clicks count toward pay or reputation. Never per-click rows, addresses, user agents or referrers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["human"],
      "properties": {
        "human": { "type": "integer", "minimum": 0 },
        "bot": { "type": "integer", "minimum": 0 },
        "preview": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      }
    },
    "Authority": {
      "title": "Authority",
      "description": "Why a party is bound. mandate: the owner's standing constraints allowed it. consent: a person approved this exact terms_hash.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["mandate", "consent"] },
        "ref": { "$ref": "#/$defs/LocalId" }
      }
    },
    "Waiting": {
      "title": "Waiting",
      "description": "Who a deal or a listing is waiting for. escalation, reasons and url appear only in the waiting party's own copy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "since"],
      "properties": {
        "party": { "$ref": "#/$defs/PartyId" },
        "step": { "$ref": "#/$defs/Step" },
        "since": { "$ref": "#/$defs/Timestamp" },
        "escalation": { "$ref": "#/$defs/LocalId" },
        "reasons": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/EscalationReason" } },
        "url": { "$ref": "#/$defs/Url", "description": "Where the owner approves or refuses. The agent shows it to its person; it can never approve by itself." }
      }
    },
    "Fit": {
      "title": "Fit",
      "description": "Why a result fits, with evidence links a human can open.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reasons"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "evidence": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/Url" } }
      }
    },
    "Trust": {
      "title": "Trust",
      "description": "Aggregate trust signals. Never a list of the party's counterparties.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reputation": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
        "completed_deals": { "type": "integer", "minimum": 0 },
        "verified": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["person", "domain", "dns", "platform_oauth", "bio_token", "challenge_post"] }, "description": "person: a person has claimed the party (passkey or signed-in session), with no identity disclosed. The others prove control of a space." },
        "path": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "Capabilities": {
      "title": "Capabilities",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messages": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/MessageType" } },
        "spaces": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SpaceKind" } },
        "actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$" } },
        "proofs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ProofMethod" } },
        "tracking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "links": { "type": "boolean" },
            "codes": { "type": "boolean" }
          }
        },
        "signatures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["EdDSA", "ES256"] } },
            "required": { "type": "boolean" }
          }
        },
        "inbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "poll": { "type": "boolean" },
            "webhook": { "$ref": "#/$defs/Url" }
          }
        },
        "ext": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ExtName" } }
      }
    }
  }
}
