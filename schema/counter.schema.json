{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.com/schema/v0.3/counter.schema.json",
  "title": "ORP v0.3 Ask / Counter Message",
  "type": "object",
  "required": [
    "orp_version",
    "message_id",
    "message_type",
    "deal_id",
    "sender",
    "timestamp",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "orp_version": {
      "$ref": "common.schema.json#/$defs/OrpVersion"
    },
    "message_id": {
      "type": "string",
      "minLength": 4
    },
    "message_type": {
      "type": "string",
      "enum": ["ask", "counter"]
    },
    "deal_id": {
      "type": "string",
      "minLength": 4
    },
    "sender": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "recipient": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 4
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    },
    "payload": {
      "type": "object",
      "required": ["seq", "terms", "terms_hash", "expires_at"],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "prior_message_id": {
          "type": "string",
          "minLength": 4
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "terms": {
          "$ref": "common.schema.json#/$defs/DealTerms"
        },
        "terms_hash": {
          "$ref": "common.schema.json#/$defs/Sha256Hash"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
