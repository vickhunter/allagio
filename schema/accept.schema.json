{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.com/schema/v0.3/accept.schema.json",
  "title": "ORP v0.3 Accept Message",
  "type": "object",
  "required": [
    "orp_version",
    "message_id",
    "message_type",
    "deal_id",
    "sender",
    "recipient",
    "timestamp",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "orp_version": {
      "$ref": "common.schema.json#/$defs/OrpVersion"
    },
    "message_id": {
      "type": "string",
      "minLength": 4
    },
    "message_type": {
      "const": "accept"
    },
    "deal_id": {
      "type": "string",
      "minLength": 4
    },
    "sender": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "recipient": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 4
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    },
    "payload": {
      "type": "object",
      "required": ["accepted_message_id", "accepted_seq", "terms_hash"],
      "properties": {
        "accepted_message_id": {
          "type": "string",
          "minLength": 4
        },
        "accepted_seq": {
          "type": "integer",
          "minimum": 1
        },
        "terms_hash": {
          "$ref": "common.schema.json#/$defs/Sha256Hash"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
