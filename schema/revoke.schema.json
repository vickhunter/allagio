{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offer-rails.com/schema/v0.3/revoke.schema.json",
  "title": "ORP v0.3 Revoke Message",
  "type": "object",
  "required": [
    "orp_version",
    "message_id",
    "message_type",
    "deal_id",
    "sender",
    "timestamp",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "orp_version": {
      "$ref": "common.schema.json#/$defs/OrpVersion"
    },
    "message_id": {
      "type": "string",
      "minLength": 4
    },
    "message_type": {
      "const": "revoke"
    },
    "deal_id": {
      "type": "string",
      "minLength": 4
    },
    "sender": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "recipient": {
      "$ref": "common.schema.json#/$defs/PrincipalUri"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 4
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    },
    "payload": {
      "type": "object",
      "required": ["revoked_by", "reason_code", "reason", "adapter_cleanup_status", "redirect_disabled"],
      "properties": {
        "revoked_by": {
          "$ref": "common.schema.json#/$defs/PrincipalUri"
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "owner_kill_switch",
            "landing_page_changed",
            "counterparty_breach",
            "policy_violation",
            "expired_or_completed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "adapter_cleanup_status": {
          "type": "string",
          "enum": ["removed", "pending_adapter", "manual_required"]
        },
        "redirect_disabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
